  */
 #include "header.h"
 #include "extern.h"
+#ifdef __amigaos__
+#include "player.h"
+#include "amiga_tty.h"
+#endif
 
 #include <term.h>
 
@@ -65,8 +69,24 @@ getcharacter ()
 {
 	char byt;
 	lflush();		/* be sure output buffer is flushed */
+#ifdef __amigaos__
+	{
+		int k = amiga_getkey();
+
+		if (k == EOF) {	/* the window closed: save, as S does */
+			clear();
+			lprcat("Saving . . .");
+			lflush();
+			savegame(savefilename);
+			wizard=1;
+			died(-257);
+		}
+		byt = k;
+	}
+#else
 /*        byt=getchar();		/* get character from terminal */
 	byt=getc(stdin);
+#endif
 	return(byt);
 }
 
